        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor User\n    participant HeatMapScreen\n    participant useHeatMap\n    participant HeatMapApiClient\n    participant HeatMapController\n    participant HeatMapService\n    participant HeatMapVO\n\n    User-&gt;&gt;HeatMapScreen: abre mapa de calor\n    HeatMapScreen-&gt;&gt;useHeatMap: loadHeatMap(defaultFilters)\n    useHeatMap-&gt;&gt;HeatMapApiClient: getHeatMap(defaultFilters)\n    HeatMapApiClient-&gt;&gt;HeatMapController: solicita mapa de calor con filtros\n    HeatMapController-&gt;&gt;HeatMapService: obtiene reportes verificados, aplica filtros y agrupa por áreas de 150 m\n    HeatMapService--&gt;&gt;HeatMapController: devuelve zonas con nivel de concentración\n    HeatMapController--&gt;&gt;HeatMapApiClient: devuelve datos del mapa de calor\n    HeatMapApiClient-&gt;&gt;HeatMapVO: mapea datos de concentración\n    HeatMapApiClient--&gt;&gt;useHeatMap: regresa datos del mapa de calor\n    useHeatMap-&gt;&gt;HeatMapScreen: actualiza heatMapData\n    HeatMapScreen--&gt;&gt;User: muestra mapa de calor inicial\n\n    User-&gt;&gt;HeatMapScreen: cambia filtro (fecha, tipo o gravedad)\n    HeatMapScreen-&gt;&gt;useHeatMap: updateFilters(filters)\n    useHeatMap-&gt;&gt;HeatMapApiClient: getHeatMap(filters)\n    HeatMapApiClient-&gt;&gt;HeatMapController: solicita mapa de calor con nuevos filtros\n    HeatMapController-&gt;&gt;HeatMapService: obtiene reportes verificados, aplica filtros y agrupa por áreas de 150 m\n    HeatMapService--&gt;&gt;HeatMapController: devuelve zonas con nivel de concentración\n    HeatMapController--&gt;&gt;HeatMapApiClient: devuelve datos filtrados del mapa de calor\n    HeatMapApiClient-&gt;&gt;HeatMapVO: mapea datos de concentración\n    HeatMapApiClient--&gt;&gt;useHeatMap: regresa datos filtrados\n    useHeatMap-&gt;&gt;HeatMapScreen: actualiza heatMapData\n    HeatMapScreen--&gt;&gt;User: muestra mapa de calor actualizado&quot;,&#xa; 