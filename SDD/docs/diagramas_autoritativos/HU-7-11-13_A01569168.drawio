        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    participant RetentionScheduler\n    participant RetentionService\n    participant AccountRepository\n    participant ReportRepository\n    participant AuditService\n\n    RetentionScheduler-&gt;&gt;RetentionService: executeRetentionPolicy()\n    RetentionService-&gt;&gt;AccountRepository: solicita cuentas inactivas por 12 meses\n    AccountRepository--&gt;&gt;RetentionService: devuelve cuentas inactivas\n    RetentionService-&gt;&gt;AccountRepository: solicita anonimización de datos personales\n    AccountRepository--&gt;&gt;RetentionService: confirma anonimización\n    RetentionService-&gt;&gt;ReportRepository: solicita conservar reportes de forma anónima\n    ReportRepository--&gt;&gt;RetentionService: confirma conservación anónima\n    RetentionService-&gt;&gt;AuditService: registra resultado técnico del proceso\n    AuditService--&gt;&gt;RetentionService: confirma registro\n    RetentionService--&gt;&gt;RetentionScheduler: devuelve resultado del proceso&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="NktWwkNeY4U4MzY7MYaS-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
