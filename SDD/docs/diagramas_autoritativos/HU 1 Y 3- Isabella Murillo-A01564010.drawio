<mxfile host="app.diagrams.net" pages="3">
  <diagram name="Page-1" id="K1hEtPZMxJKoa6ISlKp2">
    <mxGraphModel dx="3113" dy="1990" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor User\n    participant FotoYUbiScreen\n    participant ReporteScreen\n    participant UseReport\n    participant CameraModule\n    participant LocationModule as LocationModule (OpenStreetMap)\n    participant reportVO\n    participant ImageRepo as Image repot\n    participant APIClient as API Client\n    participant Controller\n    participant Service\n\n    FotoYUbiScreen--&gt;&gt;User: Muestra pantalla para subir foto y ubicación\n\n    User-&gt;&gt;FotoYUbiScreen: Toca \&quot;Agregar foto\&quot;\n    FotoYUbiScreen--&gt;&gt;User: Muestra opciones [Tomar foto / Elegir de galería]\n\n    alt Usuario elige \&quot;Tomar foto\&quot;\n        User-&gt;&gt;FotoYUbiScreen: Selecciona \&quot;Tomar foto\&quot;\n        FotoYUbiScreen-&gt;&gt;CameraModule: launchCamera()\n        CameraModule-&gt;&gt;CameraModule: takePhoto()\n        CameraModule--&gt;&gt;FotoYUbiScreen: return foto\n    else Usuario elige \&quot;Elegir de galería\&quot;\n        User-&gt;&gt;FotoYUbiScreen: Selecciona \&quot;Elegir de galería\&quot;\n        FotoYUbiScreen-&gt;&gt;CameraModule: launchImageLibrary()\n        CameraModule-&gt;&gt;CameraModule: choosePhoto()\n        CameraModule--&gt;&gt;FotoYUbiScreen: return foto\n    end\n\n    FotoYUbiScreen--&gt;&gt;User: Muestra vista previa de foto\n\n    User-&gt;&gt;FotoYUbiScreen: Selecciona \&quot;Compartir mi ubicación actual\&quot;\n    FotoYUbiScreen-&gt;&gt;LocationModule: getLocation()\n    LocationModule-&gt;&gt;LocationModule: getCurrentPosition()\n    LocationModule--&gt;&gt;FotoYUbiScreen: return {lat, lng, accuracy}\n    FotoYUbiScreen--&gt;&gt;User: Muestra vista previa de ubicación\n\n    User-&gt;&gt;FotoYUbiScreen: Selecciona \&quot;Siguiente\&quot;\n    FotoYUbiScreen-&gt;&gt;ReporteScreen: changeScreen()\n    ReporteScreen--&gt;&gt;FotoYUbiScreen: Change screen to report\n    FotoYUbiScreen--&gt;&gt;User: Muestra pantalla de reporte\n\n    User-&gt;&gt;ReporteScreen: Selecciona TipoIncidente, Gravedad, Certeza, Cantidad, Tamaño, Color, Collar, Fecha/Hora y escribe Descripción\n    User-&gt;&gt;ReporteScreen: Toca \&quot;Enviar reporte\&quot;\n\n    ReporteScreen-&gt;&gt;UseReport: enviarReporte(reportData)\n    UseReport-&gt;&gt;reportVO: new reportVO(reportData)\n    reportVO--&gt;&gt;UseReport: return reportVO\n\n    opt Hay foto adjunta\n        UseReport-&gt;&gt;ImageRepo: prepareImage(foto)\n        ImageRepo--&gt;&gt;UseReport: return imagenLista\n    end\n\n    UseReport-&gt;&gt;APIClient: enviarReporte(reportVO, imagenLista)\n    APIClient-&gt;&gt;Controller: POST /api/v1/reportes\n    Controller-&gt;&gt;Service: guardarReporte(reportVO)\n\n    alt Validación de negocio falla\n        Service--&gt;&gt;Controller: return error 400\n        Controller--&gt;&gt;APIClient: 400 Bad Request\n        APIClient--&gt;&gt;UseReport: return error\n        UseReport--&gt;&gt;ReporteScreen: notifica error\n        ReporteScreen--&gt;&gt;User: Muestra mensaje de error\n    else Validación exitosa\n        Service-&gt;&gt;Service: Guarda reporte en MySQL\n\n        opt Hay imagen\n            Service-&gt;&gt;Service: Sube imagen a almacenamiento cifrado\n        end\n\n        Service--&gt;&gt;Controller: return reporte guardado\n        Controller--&gt;&gt;APIClient: 201 Created\n        APIClient--&gt;&gt;UseReport: return confirmación\n        UseReport--&gt;&gt;ReporteScreen: actualiza estado\n        ReporteScreen--&gt;&gt;User: Muestra \&quot;Reporte enviado con éxito\&quot;\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="2_ZD9bgpjuGazsvKcVnM-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
