        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\n\ntitle ContactInfo\n\nactor Usuario\n\nbox Frontend\n\nparticipant ReportsScreen\n\nparticipant useContactsInfo\n\nparticipant ContactsVO\n\nparticipant ContactsManager\n\nparticipant ResponsesVO\n\nparticipant ResponsesManager\n\nParticipant ContactsInfoAPI\n\nend\n\nbox Backend\n\nparticipant ContactsController\n\nparticipant ContactsService\n\nend\n\nUsuario-&gt;&gt;ReportsScreen: Seleccionar la opción para Actualizar reportes y envía la información\n\nReportsScreen-&gt;&gt;useContactsInfo: Llamar al Hook\n\nuseContactsInfo-&gt;&gt;ContactsManager: Llamar al Manager\n\nContactsManager--&gt;&gt;ContactsVO: Crear un Objeto para almacenar la información\n\nContactsVO--&gt;&gt;useContactsInfo: Regresar el Objeto al Hook\n\nuseContactsInfo-&gt;&gt;ContactsInfoAPI: Llamar al endpoint mediante una API call\n\nContactsInfoAPI-&gt;&gt;ContactsController: Llamar al controller via el endpoint \&quot;v1/contact-info\&quot;\n\nContactsController-&gt;&gt;ContactsService: PostContactInfo/ Insertar nueva información de Contacto\n\nContactsService--&gt;&gt;ContactsController: Regresa un 200\n\nContactsController--&gt;&gt;useContactsInfo: Envia la response al Hook\n\nuseContactsInfo-&gt;&gt;ResponsesManager: Envia la info al Manager\n\nResponsesManager--&gt;&gt;ResponsesVO: Construye un VO\n\nResponsesVO--&gt;&gt;useContactsInfo: Regresa un VO de exito\n\nuseContactsInfo--&gt;&gt;ReportsScreen: Return the result\n\nReportsScreen--&gt;&gt;Usuario: Display the result\n\n\n\n\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="5ed2ufRQTXe2OmPV0M4V-31">
